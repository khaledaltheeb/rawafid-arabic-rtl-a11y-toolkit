{
  "name": "@rawafid/arabic-rtl-a11y-toolkit",
  "version": "0.3.0",
  "description": "Enterprise-ready Arabic/RTL accessibility, localization, bidi-safety, source auditing, SARIF, and direction-aware web tooling.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "Khaled Altheeb",
    "email": "khaledaltheeb@gmail.com",
    "url": "https://healthrenewal.org/open-source/arabic-rtl-a11y-toolkit"
  },
  "homepage": "https://healthrenewal.org/open-source/arabic-rtl-a11y-toolkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khaledaltheeb/rawafid-arabic-rtl-a11y-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/khaledaltheeb/rawafid-arabic-rtl-a11y-toolkit/issues"
  },
  "keywords": ["arabic", "rtl", "bidi", "unicode", "i18n", "localization", "accessibility", "a11y", "source-audit", "sarif", "github-actions", "devsecops", "design-system", "logical-properties", "typescript", "web"],
  "files": ["dist", "styles", "audit", "bin", "schemas/rtl-audit-config.schema.json", "docs/SOURCE-AUDIT.md", "README.md", "LICENSE", "NOTICE"],
  "bin": {
    "rawafid-rtl-audit": "./bin/rawafid-rtl-audit.mjs"
  },
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js"},
    "./styles/logical.css": "./styles/logical.css",
    "./styles/a11y.css": "./styles/a11y.css",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {"node": ">=22"},
  "publishConfig": {"access": "public", "provenance": true},
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:partner": "node scripts/run-partner-suite.mjs",
    "partner:runner-check": "npm run test:partner -- --list",
    "lint": "eslint . --max-warnings=0",
    "catalogs:check": "node scripts/validate-catalogs.mjs",
    "localization:evidence": "node scripts/localization-evidence.mjs",
    "localization:sarif-check": "node scripts/validate-localization-sarif.mjs",
    "rtl-audit:check": "node scripts/check-rtl-audit.mjs",
    "github-action:check": "node scripts/check-github-action.mjs",
    "enterprise:check": "node scripts/check-enterprise-evaluation.mjs",
    "partner-offers:check": "node scripts/check-partner-offers.mjs",
    "docs:check": "node scripts/check-documentation-contract.mjs",
    "conformance:check": "node scripts/check-conformance-manifest.mjs",
    "partner:check": "node scripts/check-partner-suite.mjs",
    "contracts:check": "node scripts/check-machine-contract-schemas.mjs",
    "research:check": "node scripts/check-research-metadata.mjs",
    "governance:check": "node scripts/check-governance-contract.mjs",
    "security:sca": "npm audit --audit-level=moderate",
    "check:core": "npm run scope:check && npm run supply-chain:check && npm run security:sca && npm run catalogs:check && npm run localization:evidence && npm run localization:sarif-check && npm run rtl-audit:check && npm run github-action:check && npm run enterprise:check && npm run partner-offers:check && npm run docs:check && npm run conformance:check && npm run partner:check && npm run contracts:check && npm run research:check && npm run governance:check && npm run partner:runner-check && npm run lint && npm run typecheck && npm run test",
    "package:lint": "npm run build && publint",
    "package:types": "npm run build && attw --pack . --profile esm-only --entrypoints .",
    "package:contract": "npm run build && node scripts/check-package-contract.mjs",
    "package:artifact": "npm run build && node scripts/check-package-artifact.mjs",
    "consumer:smoke": "npm run build && node scripts/check-packed-consumer.mjs",
    "build:reproducible": "node scripts/check-reproducible-build.mjs",
    "site:build": "npm run build && node scripts/build-review-site.mjs",
    "site:check": "npm run build && node scripts/check-review-site.mjs",
    "site:verify-deployment": "node scripts/verify-review-site-deployment.mjs",
    "site:deployment-verifier-check": "npm run build && node scripts/check-review-site-deployment-verifier.mjs",
    "public-api:check": "npm run build && node scripts/check-public-api.mjs",
    "public-types:check": "npm run build && node scripts/check-public-types.mjs",
    "check": "npm run check:core && npm run package:lint && npm run package:types && npm run package:contract && npm run package:artifact && npm run consumer:smoke && npm run build:reproducible && npm run site:check && npm run site:deployment-verifier-check && npm run public-api:check && npm run public-types:check",
    "prepack": "npm run build",
    "scope:check": "node scripts/scope-guard.mjs",
    "supply-chain:check": "node scripts/check-action-pins.mjs && node scripts/check-release-policy.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "publint": "0.3.24",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
