{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/khaledaltheeb/rawafid-arabic-rtl-a11y-toolkit/main/schemas/review-site-artifact.schema.json",
  "title": "Rawafid Public Review Site Artifact Manifest",
  "description": "Machine-readable integrity and deployment contract for the deterministic public review lab static artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifact",
    "package",
    "entrypoint",
    "deploymentModel",
    "buildInputs",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifact": {
      "const": "rawafid-public-review-lab"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "@rawafid/arabic-rtl-a11y-toolkit"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "entrypoint": {
      "const": "review-lab/index.html"
    },
    "deploymentModel": {
      "const": "static-files-subpath-safe"
    },
    "buildInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/buildInput"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileIntegrity"
      }
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "buildInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "destination", "mode"],
      "properties": {
        "source": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "destination": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "mode": {
          "enum": ["copy", "relative-path-rewrite"]
        }
      }
    },
    "fileIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
