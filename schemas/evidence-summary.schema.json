{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/khaledaltheeb/rawafid-arabic-rtl-a11y-toolkit/main/schemas/evidence-summary.schema.json",
  "title": "Rawafid partner interoperability evidence summary",
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped", "timedOut", "interrupted"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "timedOut": {"type": "integer", "minimum": 0},
        "interrupted": {"type": "integer", "minimum": 0}
      }
    },
    "namedCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "total", "passed", "failed", "skipped", "timedOut", "interrupted"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "timedOut": {"type": "integer", "minimum": 0},
        "interrupted": {"type": "integer", "minimum": 0}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "generatedAt", "run", "coverage", "summary", "projects", "domains", "tests", "nonClaims"],
  "properties": {
    "schemaVersion": {"const": 1},
    "suite": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "repository", "sha", "runId", "runAttempt"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "repository": {"type": ["string", "null"]},
        "sha": {"type": ["string", "null"]},
        "runId": {"type": ["string", "null"]},
        "runAttempt": {"type": ["string", "null"]}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserProjects", "specs", "standardsClaims", "researchAssets"],
      "properties": {
        "browserProjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "specs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "standardsClaims": {"type": "integer", "minimum": 0},
        "researchAssets": {"type": "array", "items": {"type": "object"}}
      }
    },
    "summary": {"$ref": "#/$defs/counts"},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/namedCounts"}},
    "domains": {"type": "array", "items": {"$ref": "#/$defs/namedCounts"}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "file", "title", "titlePath", "attempts", "finalStatus", "durationMs", "domains"],
        "properties": {
          "project": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "titlePath": {"type": "array", "items": {"type": "string"}},
          "attempts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["retry", "status", "durationMs"], "properties": {"retry": {"type": "integer", "minimum": 0}, "status": {"type": "string", "minLength": 1}, "durationMs": {"type": "number", "minimum": 0}}}},
          "finalStatus": {"type": "string", "minLength": 1},
          "durationMs": {"type": "number", "minimum": 0},
          "domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "nonClaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
