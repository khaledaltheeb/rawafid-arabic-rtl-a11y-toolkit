{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthrenewal.org/open-source/arabic-rtl-a11y-toolkit/schemas/partner-offer-matrix.schema.json",
  "title": "Rawafid Partner Offer Matrix",
  "description": "Evidence-led, low-friction offer profiles for organizations that may benefit from Arabic/RTL engineering collaboration without implying an existing partnership.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "principles", "offers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "license"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "format": "uri" },
        "license": { "const": "Apache-2.0" }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "offers": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/offer" }
    }
  },
  "$defs": {
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "evidence", "success", "exit"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "success": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "exit": { "type": "string", "minLength": 1 }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "audience", "problem", "offer", "rawafidContributes", "counterpartyContribution", "pilot", "publicEvidence", "nonClaims"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "audience": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "problem": { "type": "string", "minLength": 1 },
        "offer": { "type": "string", "minLength": 1 },
        "rawafidContributes": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "counterpartyContribution": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pilot": { "$ref": "#/$defs/pilot" },
        "publicEvidence": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
